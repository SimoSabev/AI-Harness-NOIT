  test_globs:
    - tests/**
    - "**/*.spec.ts"
    - "**/*.test.ts"
    - "**/*.spec.js"
    - "**/*.test.js"
ci:
  provider: github_actions
  workflow: .github/workflows/ci.yml
  required_checks:
    - test
task_types:
  bugfix:
    allowed_paths:
      - src/**
      - packages/**
    may_change_tests: false
    risk_class: medium
  feature:
    allowed_paths:
      - src/**
      - packages/**
      - tests/**
    may_change_tests: true
    risk_class: medium
  docs:
    allowed_paths:
      - README.md
      - docs/**
    may_change_tests: false
    risk_class: low
risk_classes:
  low:
    level_cap: 3
  medium:
    level_cap: 2
  high:
    level_cap: 1
    requires_second_factor: true
protected_paths:
  - .github/**
