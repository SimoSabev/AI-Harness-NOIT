  - .mcp.json
  - .codex/**
  - AGENTS.md
  - CLAUDE.md
  - .npmrc
  - "**/__snapshots__/**"
  - pnpm-workspace.yaml
  - turbo.json
protected_json_fields:
  package.json:
    - scripts
    - overrides
    - workspaces
    - imports
config_paths:
  - .mandat.yml
  - .claude/**
  - .codex/**
  - .npmrc
  - AGENTS.md
  - CLAUDE.md
budgets:
  task_usd: 2
  task_minutes: 30
models:
  allowed:
