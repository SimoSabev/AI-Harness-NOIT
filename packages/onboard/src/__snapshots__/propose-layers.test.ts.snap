          "D1",
          "D2",
          "D3",
          "D4",
          "D10",
        ],
      },
      "models": {
        "allowed": [
          "claude",
          "codex",
        ],
        "default": "claude",
      },
      "protected_json_fields": {
        "package.json": [
          "scripts",
          "overrides",
          "workspaces",
          "imports",
        ],
      },
      "protected_paths": [
        ".github/**",
        ".mandat.yml",
        ".claude/**",
        ".mcp.json",
        ".codex/**",
        "AGENTS.md",
        "CLAUDE.md",
        ".npmrc",
        "**/__snapshots__/**",
      ],
      "risk_classes": {
        "high": {
          "level_cap": 1,
          "requires_second_factor": true,
        },
        "low": {
          "level_cap": 3,
          "requires_second_factor": false,
        },
        "medium": {
          "level_cap": 2,
          "requires_second_factor": false,
        },
      },
      "runtime": {
        "install": "pnpm install --frozen-lockfile --ignore-scripts",
        "node": "24",
        "package_manager": "pnpm",
      },
      "security": {
        "max_diff_mb": 20,
        "max_file_mb": 5,
        "max_files": 500,
      },
      "task_types": {
        "bugfix": {
          "allowed_paths": [
            "src/**",
          ],
          "may_change_tests": false,
          "risk_class": "medium",
        },
        "docs": {
          "allowed_paths": [
            "README.md",
            "docs/**",
          ],
          "may_change_tests": false,
          "risk_class": "low",
        },
        "feature": {
          "allowed_paths": [
            "src/**",
            "tests/**",
          ],
          "may_change_tests": true,
          "risk_class": "medium",
        },
      },
      "tests": {
        "command": "npx jest --json --outputFile=$MANDAT_REPORT",
        "env": {
          "CI": "true",
        },
        "framework": "jest",
        "test_globs": [
          "tests/**",
          "**/*.spec.ts",
          "**/*.test.ts",
          "**/*.spec.js",
          "**/*.test.js",
        ],
      },
      "version": 2,
    },
    "b": {
      "boundaries": [
        "Do not change .github/** (high risk: github).",
        "Never push, never call the network; the harness delivers the change.",
      ],
      "commands": {
        "install": "pnpm install --frozen-lockfile --ignore-scripts",
        "lint": "pnpm lint",
        "test": "pnpm test",
        "test_one": "npx jest {file}",
      },
      "conventions": [
        "commit titles: conventional (<type>: <what>) in 4/4",
        "median change: 10 lines",
      ],
      "links": [],
      "style": [
        "indent: 2 spaces (.editorconfig)",
        "formatter: prettier (.prettierrc)",
      ],
      "summary": "",
      "task_types": [
        "bugfix",
        "feature",
        "docs",
      ],
    },
    "c": [
      {
        "decision": "deny",
        "reason": "the harness delivers, never the agent",
        "subject": "any",
        "tool": "bash:git push *",
      },
      {
        "decision": "deny",
        "reason": "no network outside the gate",
        "subject": "any",
        "tool": "bash:curl *",
      },
      {
        "decision": "deny",
        "reason": "no network outside the gate",
        "subject": "any",
        "tool": "bash:wget *",
      },
      {
        "decision": "deny",
        "reason": "high-risk folder (rule:github)",
        "subject": "any",
        "tool": "path:write:.github/**",
      },
    ],
    "d": [
      {
        "args": {},
        "event": "pre_tool",
        "matcher": "Bash",
        "script": "deny-by-policy",
      },
      {
        "args": {},
        "event": "stop",
        "matcher": null,
        "script": "require-tests-ran",
      },
    ],
    "e": {
      "mcp": [
        {
          "digest": null,
          "egress_hosts": [],
          "enabled_tools": [
            "mandat_status",
            "mandat_verify",
            "mandat_explain",
          ],
          "name": "mandat",
          "package": null,
          "secrets": [],
          "tools_hash": null,
          "transport": "http",
          "url": "http://egress-gate/mcp/mandat",
          "version": "1",
        },
      ],
      "plugins": [],
      "skills": [
        {
          "content_hash": "sha256:a30804daebffdb6a6bf489779cd82d89dd421cf971971334ea8dbe782b931450",
          "description": "Write the failing test first, then the smallest change that makes it pass.",
          "name": "test-first",
          "source": "builtin",
        },
      ],
    },
    "f": {
      "roles": [
        {
          "description": "Reads the change and reports problems; never writes.",
          "max_turns": 20,
          "model": "claude-haiku-5-5",
          "role": "reviewer",
          "tools": [
            "path:read:**",
          ],
        },
      ],
    },
    "g": {
      "ci_rounds": 2,
      "definition_of_done": {
        "bugfix": [
          "a test that failed before passes",
          "no test removed or weakened",
        ],
        "docs": [
          "only documentation files change",
        ],
      },
      "hidden_tests_dir": "tests/__hidden__",
      "max_depth": 1,
      "max_diff_lines": 400,
      "max_subagents": 2,
      "mutants": 3,
      "required_detectors": [
        "D1",
        "D2",
        "D3",
