{
  "name": "@mandat/site",
  "version": "0.1.0",
  "private": true,
  "description": "The download and docs site of the harness: a static Next.js export with the same design tokens as apps/web",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-assets.mjs && NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "node scripts/copy-assets.mjs && NEXT_TELEMETRY_DISABLED=1 next dev -p 3100",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mandat/contract": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
