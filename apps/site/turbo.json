{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "scripts/**",
        "releases.json",
        "next.config.ts",
        "postcss.config.mjs",
        "tsconfig.json",
        "package.json",
