{
  "name": "@mandat/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Harness desktop: an Electron window around `pnpm local` (D-303). Not in the pnpm workspace; installed on demand.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js && node scripts/setup-pty.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist-preload/preload.js','dist/preload.cjs')\"",
    "test": "pnpm --dir ../.. exec vitest run apps/desktop/src",
    "start": "electron .",
    "smoke": "electron scripts/smoke-bridge.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@mandat/contract": "link:../../packages/contract",
    "node-pty": "1.1.0"
  }
}
