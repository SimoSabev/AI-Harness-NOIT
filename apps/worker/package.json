{
  "name": "@mandat/worker",
  "version": "0.1.0",
  "private": true,
  "description": "The orchestrator of `mandat run`",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./push": {
      "types": "./dist/online/push.d.ts",
      "default": "./dist/online/push.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. apps/worker/"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mandat/agents": "workspace:*",
    "@mandat/channels": "workspace:*",
    "@mandat/contract": "workspace:*",
    "@mandat/core": "workspace:*",
    "@mandat/egress-gate": "workspace:*",
    "@mandat/export": "workspace:*",
    "@mandat/gate-github": "workspace:*",
    "@mandat/ledger": "workspace:*",
    "@mandat/llm-proxy": "workspace:*",
    "@mandat/memory": "workspace:*",
    "@mandat/onboard": "workspace:*",
    "@mandat/profile": "workspace:*",
    "@mandat/redaction": "workspace:*",
    "@mandat/sandbox": "workspace:*",
    "@mandat/verify": "workspace:*",
    "@octokit/webhooks": "14.2.0",
    "pg": "8.23.1",
    "web-push": "3.6.7",
    "@mandat/review": "workspace:*",
    "@mandat/research": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "yaml": "2.9.1"
  }
}
