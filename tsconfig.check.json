{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "paths": {
      "@mandat/worker": [
        "./apps/worker/src/index.ts"
      ],
      "@mandat/*": [
        "./packages/*/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "scripts/**/*.test.ts",
    "vitest.config.ts",
    "vitest.docker.config.ts",
    "vitest.shared.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "fixtures/**"
  ]
}
