{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "paths": {
      "@mandat/research/report": [
        "./packages/research/src/report.ts"
      ],
      "@mandat/mcp-bridge/registry": [
        "./packages/mcp-bridge/src/registry.ts"
      ],
      "@mandat/worker": [
        "./apps/worker/src/index.ts"
      ],
      "@mandat/bench": [
        "./bench/index.ts"
      ],
      "@mandat/*": [
        "./packages/*/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "scripts/**/*.test.ts",
    "vitest.config.ts",
    "vitest.docker.config.ts",
    "vitest.live.config.ts",
    "vitest.shared.ts",
    "bench/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "fixtures/**",
    "apps/web/**",
    "apps/site/**",
    "apps/desktop/src/main.ts"
  ]
}
