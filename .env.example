# Names only, no values. This repository never loads .env files (no dotenv; AGENTS.md rule 4).
ANTHROPIC_API_KEY  # only for `pnpm mandat proxy start`; never in a repository .env
MANDAT_HOME  # default <repo>/.mandat (D-054)
MANDAT_PROXY_ADMIN_PORT  # default 8788; read by proxy start, run and doctor (D-054)
DOCKER_HOST  # optional; passed through to the docker CLI only
# E1+ (demo prompt т. 0.7; spec т. 17). Names only.
OPENAI_API_KEY  # only for `pnpm mandat proxy start`; never in a repository .env
MANDAT_MODE
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY  # server only; never logged
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_ACCESS_TOKEN
SUPABASE_DB_PASSWORD
SUPABASE_PROJECT_ID
GITHUB_WRITER_APP_ID
GITHUB_WRITER_PRIVATE_KEY  # Simo's terminal only (live tests)
GITHUB_WRITER_WEBHOOK_SECRET
GITHUB_OBSERVER_APP_ID
GITHUB_OBSERVER_PRIVATE_KEY  # Simo's terminal only (live tests)
GITHUB_OBSERVER_WEBHOOK_SECRET
VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY  # Simo's terminal only
VAPID_SUBJECT
TSA_URLS
MANDAT_LLM_PROXY_URL
MANDAT_SYNC_POLL_SECONDS  # default 30 (D-215)
MANDAT_BARE_MIRRORS_DIR
MANDAT_DEMO_ORG_BUDGET_USD_DAY
GITHUB_DEMO_REPO  # owner/name
GITHUB_WRITER_INSTALLATION_ID
GITHUB_OBSERVER_INSTALLATION_ID
MANDAT_STATE_MAX_MIN_<STATE>  # one per state (т. 3.4, D-211)
MANDAT_LIVE_TSA  # 1 = run the live TSA test
MANDAT_WEBHOOK_PORT
MANDAT_WEBHOOK_HOST  # default 127.0.0.1 (D-215)
NEXT_PUBLIC_APP_URL
MANDAT_UPSTREAM_ANTHROPIC
MANDAT_UPSTREAM_OPENAI
MANDAT_VERIFYD_SOCKET
MANDAT_PUSH_TEST_ENDPOINT  # only with NODE_ENV=test
MANDAT_DB_URL  # worker/CLI Postgres URL; default = local Supabase (D-273)
